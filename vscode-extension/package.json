{
  "name": "pku-grid-cpp-coach",
  "displayName": "北大编程网格 · C++ 学习教练",
  "description": "Chrome 连接编程网格，VS Code 读取当前 C++ 并提供保存、提示、交流、网站测试与正式提交。",
  "publisher": "local-coach",
  "version": "0.2.11",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:cpp",
    "onWebviewPanel:gridCoach",
    "onWebviewPanel:gridCoachJudge"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gridCoachProblems",
          "title": "编程网格题目",
          "icon": "problem-icon.svg"
        }
      ]
    },
    "views": {
      "gridCoachProblems": [
        {
          "type": "webview",
          "id": "gridCoach.problemStatement",
          "name": "当前题目信息"
        }
      ]
    },
    "commands": [
      {
        "command": "gridCoach.quickSave",
        "title": "编程网格：快捷保存"
      },
      {
        "command": "gridCoach.hint",
        "title": "编程网格：提示"
      },
      {
        "command": "gridCoach.judge",
        "title": "编程网格：网站测试与正式提交"
      },
      {
        "command": "gridCoach.discussion",
        "title": "编程网格：交流"
      },
      {
        "command": "gridCoach.bindProblem",
        "title": "编程网格：关联当前 C++ 文件与 Chrome 题目"
      },
      {
        "command": "gridCoach.configureBackend",
        "title": "编程网格：选择本机程序目录"
      },
      {
        "command": "gridCoach.showRecords",
        "title": "编程网格：打开保存记录与报告目录"
      },
      {
        "command": "gridCoach.organizeProjectByDate",
        "title": "编程网格：按日期整理项目源码"
      },
      {
        "command": "gridCoach.selectModel",
        "title": "编程网格：选择 AI 模型与推理强度"
      },
      {
        "command": "gridCoach.openSettings",
        "title": "编程网格：打开插件设置"
      }
    ],
    "configuration": [
      {
        "title": "编程网格 · AI 模型",
        "properties": {
          "gridCoach.ai.model": {
            "type": "string",
            "default": "gpt-6-luna",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$",
            "maxLength": 120,
            "description": "提示、交流和后台报告使用的模型。可通过“选择 AI 模型与推理强度”选择或输入自定义模型 ID。是否可用取决于当前 Codex 登录账号。",
            "scope": "application"
          },
          "gridCoach.ai.effort": {
            "type": "string",
            "default": "low",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "enumDescriptions": [
              "不进行额外推理（仅支持此强度的模型，例如 Luna）",
              "低：日常学习、优先速度",
              "中：适当增加分析",
              "高：复杂问题",
              "很高：可能更慢、消耗更多额度",
              "最大：可能更慢、消耗更多额度"
            ],
            "description": "对提示、交流和后台报告统一生效；从下一次 AI 请求开始使用。",
            "scope": "application"
          }
        }
      },
      {
        "title": "编程网格 · AC · Accepted",
        "properties": {
          "gridCoach.verdicts.AC.text": {
            "type": "string",
            "default": "",
            "maxLength": 120,
            "description": "大字头显示文字；留空保留网站判定的完整名称。只改变标题，不改动网站原文。",
            "scope": "application"
          },
          "gridCoach.verdicts.AC.fontSize": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 200,
            "description": "大字头字号（px）；0 使用默认自适应字号，最大 200。",
            "scope": "application"
          },
          "gridCoach.verdicts.AC.color": {
            "type": "string",
            "default": "",
            "pattern": "^$|^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "大字头颜色，例如 #5138ea 或 #e87863；留空使用默认颜色。",
            "scope": "application"
          }
        }
      },
      {
        "title": "编程网格 · WA · Wrong Answer",
        "properties": {
          "gridCoach.verdicts.WA.text": {
            "type": "string",
            "default": "",
