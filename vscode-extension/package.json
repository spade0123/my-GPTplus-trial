{
  "name": "openjudge-cpp-coach",
  "displayName": "OpenJudge C++ 学习教练",
  "description": "内置 337 道经典题，支持上一题/下一题；测试运行、提示、交流三个按钮，源码和记录保存在本机。",
  "publisher": "local-coach",
  "version": "0.3.0",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:cpp",
    "onWebviewPanel:openjudgeCoach"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{"id":"openjudgeCoachProblems","title":"OpenJudge 题目","icon":"problem-icon.svg"}]
    },
    "views": {
      "openjudgeCoachProblems": [{"type":"webview","id":"openjudgeCoach.problemStatement","name":"经典题库与题面"}]
    },
    "commands": [
      {
        "command": "openjudgeCoach.openLibrary",
        "title": "OpenJudge：打开经典题库（337 题）"
      },
      {
        "command": "openjudgeCoach.testRun",
        "title": "OpenJudge：测试运行（保存代码并运行样例）"
      },
      {
        "command": "openjudgeCoach.hint",
        "title": "OpenJudge：提示"
      },
      {
        "command": "openjudgeCoach.discussion",
        "title": "OpenJudge：交流"
      },
      {
        "command": "openjudgeCoach.bindProblem",
        "title": "OpenJudge：关联当前 C++ 文件与 Chrome 题目"
      },
      {
        "command": "openjudgeCoach.bindSubmission",
        "title": "OpenJudge：选择本题提交详情标签"
      },
      {
        "command": "openjudgeCoach.configureBackend",
        "title": "OpenJudge：选择本机程序目录"
      },
      {
        "command": "openjudgeCoach.showRecords",
        "title": "OpenJudge：打开保存记录与报告目录"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spade0123/my-GPTplus-trial.git",
    "directory": "vscode-extension"
  }
}
