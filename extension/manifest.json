{
  "manifest_version": 3,
  "name": "OpenJudge · VS Code 连接",
  "version": "2.0.0",
  "description": "仅按 VS Code 按钮请求读取百练/NOI 题面和评测，不修改网页、不保存 Chrome 数据。",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://bailian.openjudge.cn/*",
    "https://bailian.openjudge.cn/*",
    "http://noi.openjudge.cn/*",
    "https://noi.openjudge.cn/*"
  ],
  "background": {
    "service_worker": "openjudge-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "连接 OpenJudge 与 VS Code"
  },
  "key": ""
}