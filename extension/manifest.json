{
  "manifest_version": 3,
  "name": "北大 C++ 学习教练",
  "version": "1.9.0",
  "minimum_chrome_version": "116",
  "description": "右下角仅提供快捷保存、提示、交流三个按钮；只读取题目和源码，记录存本机，不修改原编辑器、测试提交或网站存储。",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "floating-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "storage-transfer.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "显示右下角学习教练按钮"
  },
  "key": "",
  "host_permissions": [
    "https://programming.pku.edu.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assist-window.html"
      ],
      "matches": [
        "https://programming.pku.edu.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://programming.pku.edu.cn/probset/*/*/ide.do*"
      ],
      "js": [
        "floating-buttons.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
