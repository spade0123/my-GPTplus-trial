{
  "manifest_version": 3,
  "name": "OpenJudge · VS Code 连接",
  "version": "2.2.0",
  "description": "只读同步原文题面到 VS Code；主动点击才运行样例或向 OJ 提交，不访问网站存储。",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://bailian.openjudge.cn/*",
    "https://bailian.openjudge.cn/*",
    "http://noi.openjudge.cn/*",
    "https://noi.openjudge.cn/*"
  ],
  "background": {
    "service_worker": "openjudge-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "连接 OpenJudge 与 VS Code"
  },
  "key": ""
}
