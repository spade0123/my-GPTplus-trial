{
  "manifest_version": 3,
  "name": "编程网格 · VS Code 连接",
  "version": "0.1.1",
  "description": "同步编程网格题面；点击按钮才发送当前 VS Code 代码到网站评测。",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://programming.pku.edu.cn/*"
  ],
  "background": {
    "service_worker": "grid-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "连接编程网格与 VS Code"
  },
  "key": ""
}
