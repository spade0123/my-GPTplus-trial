{
  "manifest_version": 3,
  "name": "北大 C++ 学习教练",
  "version": "1.4.0",
  "description": "在北大 IDE 页面分析并保存自己的 C++ 作业，供每周复盘使用。",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://programming.pku.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://programming.pku.edu.cn/probset/*/*/ide.do*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "请在北大题目 IDE 页面使用右下角按钮"
  },
  "key": ""
}
